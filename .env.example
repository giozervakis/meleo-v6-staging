# ============================================================
# MELEO — ρυθμίσεις περιβάλλοντος
# Αντίγραψε σε .env και συμπλήρωσε. ΜΗΝ ανεβάσεις ποτέ το .env σε git.
# ============================================================

# ---------- Βασικά ----------
NODE_ENV=production
PORT=8787
# Το δημόσιο URL της πλατφόρμας. Σε production ΠΡΕΠΕΙ να είναι https,
# αλλιώς ο server δεν ξεκινά (χρησιμοποιείται σε Stripe redirects & emails).
APP_URL=https://meleo.gr
# 1 όταν τρέχεις πίσω από nginx / load balancer (σωστά client IPs στο rate limiting).
TRUST_PROXY=1

# ---------- Βάση δεδομένων (ΥΠΟΧΡΕΩΤΙΚΟ σε production) ----------
# PostgreSQL. Χωρίς αυτό ο server σε production ΔΕΝ ξεκινά.
DATABASE_URL=postgres://meleo:ΑΛΛΑΞΕ_ΜΕ@localhost:5432/meleo
# 1 αν ο πάροχος απαιτεί SSL (π.χ. Neon, Supabase, RDS). Εναλλακτικά βάλε ?sslmode=require στο URL.
DATABASE_SSL=0
# Με 3 app instances: 8 = έως ~24 application DB connections συνολικά.
DATABASE_POOL_MAX=8

# ---------- Redis v5.1 (shared rate limiting / cache) ----------
# Χρησιμοποίησε μακρύ URL-safe password (γράμματα/αριθμοί) για να μπορεί να μπει και στο URL.
REDIS_PASSWORD=ΑΛΛΑΞΕ_ΜΕ_ΤΥΧΑΙΟ_ΙΣΧΥΡΟ_PASSWORD
REDIS_URL=redis://:ΑΛΛΑΞΕ_ΜΕ_ΤΥΧΑΙΟ_ΙΣΧΥΡΟ_PASSWORD@localhost:6379/0
# Σε production v5.1 = 1. Αν Redis δεν είναι διαθέσιμο, /api/ready επιστρέφει 503.
# Το runtime limiter πάντως έχει PostgreSQL fallback για προσωρινές διακοπές.
REDIS_REQUIRED=1
REDIS_KEY_PREFIX=meleo:v56:
REDIS_CONNECT_TIMEOUT_MS=2500
REDIS_MAXMEMORY=256mb
# Μόνο για τον JSON driver (τοπική ανάπτυξη χωρίς DATABASE_URL).
DATA_DIR=

# ---------- Πληρωμές (Stripe) ----------
# Live key για πραγματικές χρεώσεις (sk_live_...). Με sk_test_... δεν εισπράττονται χρήματα.
STRIPE_SECRET_KEY=
# Από το Stripe Dashboard → Developers → Webhooks → endpoint https://meleo.gr/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=
# Price IDs των μηνιαίων συνδρομών (BASIC 9,99€ / PREMIUM 14,99€).
# Αν μείνουν κενά, δημιουργούνται inline τιμές — δουλεύει, αλλά χαλάει τα reports του Stripe.
STRIPE_PRICE_BASIC=
STRIPE_PRICE_PREMIUM=
# Αυτόματος υπολογισμός ΦΠΑ (απαιτεί ενεργό Stripe Tax). Συνεννοήσου με τον λογιστή σου.
STRIPE_AUTOMATIC_TAX=0
STRIPE_COLLECT_TAX_ID=1
STRIPE_PORTAL_ENABLED=1

# ---------- Email (Resend) ----------
# Χωρίς κλειδί δεν φεύγει κανένα email: ούτε επιβεβαίωση, ούτε reset κωδικού.
RESEND_API_KEY=
MAIL_FROM=MELEO <no-reply@meleo.gr>
SUPPORT_EMAIL=support@meleo.gr

# ---------- Admin ----------
ADMIN_EMAIL=admin@meleo.gr
# Τουλάχιστον 12 χαρακτήρες, αλλιώς ο server σε production δεν ξεκινά.
ADMIN_PASSWORD=
ADMIN_IP_ALLOWLIST=
ADMIN_SESSION_TTL_HOURS=8
ADMIN_BIND_USER_AGENT=1

# ---------- Νομικά / GDPR ----------
LEGAL_COMPANY_NAME=
LEGAL_VAT_NUMBER=
LEGAL_ADDRESS=
DPO_EMAIL=privacy@meleo.gr
TERMS_VERSION=2026-08-21
EMERGENCY_NUMBER=112

# ---------- Λειτουργικές σημαίες (αγνοούνται σε production) ----------
# Demo δεδομένα, demo social login και demo checkout χωρίς πραγματική χρέωση.
SEED_DEMO=0
DEMO_AUTH=0
DEMO_CHECKOUT=0

# --- Production hardening v3.3.1 ---
# Base32 secret for Admin TOTP / Google Authenticator / Authy
ADMIN_TOTP_SECRET=
# 32+ chars. Used to encrypt sensitive booking notes and verification files.
SENSITIVE_DATA_KEY=
VERIFICATION_STORAGE_DIR=./secure_uploads
SUBSCRIPTION_GRACE_DAYS=3

# ---------- Geocoding v5 ----------
# Production recommendation: mapbox. Nominatim remains development fallback.
GEOCODING_PROVIDER=mapbox
MAPBOX_TOKEN=

# v5.2 observability / worker
OBSERVABILITY_TOKEN=CHANGE_ME_LONG_RANDOM_TOKEN
SLOW_REQUEST_MS=1000
WORKER_CONCURRENCY=5
WORKER_POLL_MS=1000

# MELEO v5.3 — private S3-compatible verification document storage
# Production requires STORAGE_DRIVER=s3. Development may keep local.
STORAGE_DRIVER=s3
S3_ENDPOINT=https://s3.example.com
S3_REGION=eu-central-1
S3_BUCKET=meleo-verification-private
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME
SIGNED_DOCUMENT_URL_TTL_SECONDS=120

# ---------- MELEO v5.7 Release Candidate / backup drill ----------
# Φάκελος production backups (ιδανικά mounted σε ξεχωριστό encrypted/offsite volume).
BACKUP_DIR=./backups
# ΠΡΟΣΟΧΗ: disposable database ΜΟΝΟ για δοκιμή restore. Ποτέ ίδια με DATABASE_URL.
RESTORE_DATABASE_URL=
# Safety switch: γράψε YES μόνο όταν θέλεις συνειδητά να εκτελέσεις restore drill.
ALLOW_RESTORE_DRILL=NO
# Προαιρετικά συγκεκριμένο .dump· αλλιώς χρησιμοποιείται το τελευταίο backup report.
RESTORE_BACKUP_FILE=
# Πόσες ώρες θεωρείται έγκυρο το evidence για τελικό GO/NO-GO.
RELEASE_EVIDENCE_MAX_AGE_HOURS=72

# ---------- MELEO v6.0 Production Launch ----------
RELEASE_EVIDENCE_MAX_AGE_HOURS=72
LAUNCH_APPROVED=NO
RELEASE_TAG=v6.0.0

# ---------- MELEO v6.1.2 resilience ----------
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_STATEMENT_TIMEOUT_MS=15000
DATABASE_QUERY_TIMEOUT_MS=20000
REDIS_COMMAND_TIMEOUT_MS=3000

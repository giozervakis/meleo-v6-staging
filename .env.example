# ---------- MELEO v6.2 Disaster Recovery ----------
# Maximum accepted time between recoverable database points.
BACKUP_RPO_HOURS=24

# Maximum target duration for a verified recovery.
BACKUP_RTO_MINUTES=30

# Local/offsite backup retention policy.
BACKUP_RETENTION_DAYS=14
BACKUP_RETENTION_COUNT=30

# ---------- MELEO v6.2.1 disaster recovery ----------
DR_BACKUP_MAX_AGE_HOURS=24
DR_RESTORE_MAX_AGE_HOURS=168
DR_MAX_RTO_SECONDS=900

# Production must explicitly require remote/off-site backup.

# Supported architecture examples:
# s3 | r2 | b2 | azure | gcs

# Dedicated secret used only for signing DR evidence.
# Production: random secret >=32 characters.
DR_EVIDENCE_SIGNING_KEY=

# Production must fail when the remote backup cannot be verified.

# s3 | r2 | b2 | other-s3-compatible

# Separate backup endpoint/bucket are recommended.
# Endpoint may fall back to S3_ENDPOINT.

# Dedicated credentials are recommended.
# If blank, the implementation can fall back to S3_ACCESS_KEY_ID /
# S3_SECRET_ACCESS_KEY.

# Remote layout example:
# database-backups/2026/meleo-....dump

# true supports providers that use endpoint/bucket/object paths.

# ---------- MELEO v6.2.1 DR off-site storage ----------

# Production MUST set this to true.
DR_OFFSITE_REQUIRED=false

# s3 | r2 | b2 | other-s3-compatible
DR_OFFSITE_PROVIDER=

# Dedicated backup object-storage endpoint.
DR_OFFSITE_ENDPOINT=
DR_OFFSITE_REGION=eu-central-1
DR_OFFSITE_BUCKET=

# Dedicated least-privilege backup credentials.
DR_OFFSITE_ACCESS_KEY_ID=
DR_OFFSITE_SECRET_ACCESS_KEY=

# Remote object namespace.
DR_OFFSITE_PREFIX=database-backups

# Use true for path-style S3-compatible providers when required.
DR_OFFSITE_FORCE_PATH_STYLE=true

DR_OFFSITE_TIMEOUT_MS=30000

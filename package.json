    "dr:verify": "npm run dr:policy && npm run dr:evidence && npm run dr:evidence:sign",
    "release:go-no-go:core": "node scripts/release-go-no-go.mjs",
    "release:dr-gate": "node scripts/v620-release-dr-gate.mjs",
    "release:production": "npm run ci:production && npm run release:dr-gate && npm run release:go-no-go:core",
    "frontend-version-check": "node scripts/frontend-version-check.mjs",
    "tax-readiness-check": "node scripts/tax-readiness-selftest.mjs",
    "stripe-reconciliation-check": "node scripts/stripe-reconciliation-selftest.mjs",
    "request-observability-check": "node scripts/request-observability-selftest.mjs",
    "http-metrics-check": "node scripts/http-metrics-selftest.mjs",
    "error-observability-check": "node scripts/error-observability-selftest.mjs",
    "operational-metrics-check": "node scripts/operational-metrics-selftest.mjs",
    "readiness-alerting-check": "node scripts/readiness-alerting-selftest.mjs",
    "rc3-d1-check": "node scripts/rc3-d1-home-i18n-selftest.mjs",

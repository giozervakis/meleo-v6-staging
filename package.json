{
  "name": "meleo-production-architecture",
  "private": true,
  "version": "6.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n API,WEB -c auto \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite --host 0.0.0.0",
    "dev:api": "node --watch server/index.js",
    "build": "vite build",
    "start": "node server/index.js",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke-test.mjs",
    "concurrency": "node scripts/concurrency-test.mjs",
    "check": "npm run typecheck && npm run build",
    "security-selftest": "node scripts/security-selftest.mjs",
    "dev:stack": "docker compose -f docker-compose.dev.yml up --build",
    "db:migrate": "node scripts/db-migrate.mjs",
    "migrate:legacy": "node scripts/migrate-legacy-to-v5.mjs",
    "architecture-check": "node scripts/architecture-check.mjs",
    "loadtest": "node scripts/load-test-v55.mjs",
    "cluster-check": "node scripts/cluster-check.mjs",
    "worker": "node server/worker.js",
    "queue-check": "node scripts/queue-check.mjs",
    "storage-check": "node scripts/storage-check.mjs",
    "storage:migrate": "node scripts/migrate-verification-storage.mjs",
    "frontend-architecture-check": "node scripts/frontend-architecture-check.mjs",
    "e2e": "node scripts/e2e-critical.mjs",
    "e2e:browser": "node scripts/e2e-browser-check.mjs",
    "e2e:browser:install": "npx playwright install chromium",
    "loadtest:stages": "node scripts/load-stages.mjs",
    "release-check": "npm run typecheck && npm run build && npm run frontend-architecture-check && npm run architecture-check",
    "v55-check": "node scripts/v55-check.mjs",
    "security:secrets": "node scripts/secret-scan.mjs",
    "security:audit": "npm audit --audit-level=high",
    "security:check": "npm run security:secrets && npm run security-selftest && npm run security:audit",
    "v56-check": "node scripts/v56-check.mjs",
    "ci:gate": "npm run typecheck && npm run build && npm run frontend-architecture-check && npm run architecture-check && npm run v55-check && npm run v56-check && npm run security:secrets && npm run security-selftest",
    "release:preflight": "node scripts/release-preflight.mjs",
    "release:tls": "node scripts/tls-readiness.mjs",
    "release:stripe": "node scripts/stripe-readiness.mjs",
    "backup:db": "node scripts/backup-db.mjs",
    "restore:drill": "node scripts/restore-drill.mjs",
    "release:go-no-go": "node scripts/release-go-no-go.mjs",
    "v57-check": "node scripts/v57-check.mjs",
    "release:manifest": "node scripts/release-manifest.mjs",
    "release:launch-guard": "node scripts/launch-guard.mjs",
    "v60-check": "node scripts/v60-check.mjs",
    "start:render-staging": "node scripts/render-staging-start.mjs",
    "render:check": "node scripts/render-staging-check.mjs"
  },
  "dependencies": {
    "express": "5.2.1",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "stripe": "^22.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.4",
    "concurrently": "10.0.5",
    "typescript": "5.9.3",
    "vite": "8.2.0"
  },
  "engines": {
    "node": ">=22"
  }
}
